:root{--ink:#14303a;--bg:#f2f6f6;--card:#fff;--acc:#0e6b6b;--line:#d5e0e0;--mut:#5f7780;--bad:#c4452f;--ok:#2f855a;--plan:#d69e2e}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,"Segoe UI",sans-serif}
.wrap{max-width:980px;margin:0 auto;padding:16px}
.bar{background:var(--ink);color:#fff;display:flex;gap:10px;align-items:center;padding:10px 16px;flex-wrap:wrap}
.bar b{font-size:18px;margin-right:auto}
.bar button{background:#ffffff22;color:#fff;border:0}
button,select,input,textarea{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--ink)}
button{background:var(--acc);color:#fff;border:0;cursor:pointer}
button.ghost{background:none;color:var(--acc);padding:4px 0}
button.danger{background:var(--bad)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px;margin:12px 0}
.head{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:flex-start}
h2,h3{margin:.2em 0}
.muted{color:var(--mut);margin:0}.warn{color:var(--bad);margin:4px 0}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.stats div{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px}
.stats small{color:var(--mut);display:block}.stats b{font-size:19px}
.stats .bal b{color:var(--bad)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.grid label{display:flex;flex-direction:column;font-size:13px;color:var(--mut);gap:3px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}
.row>input[type=search]{flex:1}
table{width:100%;border-collapse:collapse}
td,th{text-align:left;padding:7px 6px;border-bottom:1px solid var(--line);vertical-align:top}
.pt{cursor:pointer}.pt:hover{background:#eef5f5}
.tag{padding:1px 8px;border-radius:99px;font-size:12px;color:#fff;background:var(--plan)}.tag.done{background:var(--ok)}.tag.due{background:var(--bad)}
.chart{overflow-x:auto;padding:6px 0}
.arch{display:flex;gap:3px;justify-content:center;min-width:640px;margin:6px 0;align-items:flex-start}
.arch.low{align-items:flex-end}
.mid{height:2px;background:var(--line);min-width:640px;margin:4px 0}
.tooth{width:36px;padding:0;color:var(--ink);background:#fff;border:2px solid #9bb2b5;font-size:12px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:3px}
.low .tooth{align-items:flex-start;padding:3px 0 0}
.t1,.t2{height:46px;border-radius:6px 6px 14px 14px}.t3{height:52px;border-radius:6px 6px 18px 18px}
.t4,.t5{height:44px;border-radius:10px}.t6,.t7,.t8{height:42px;width:42px;border-radius:8px}
.low .t1,.low .t2,.low .t3{border-radius:14px 14px 6px 6px}
.tooth.plan{border-color:var(--plan);background:#fdf3d8}.tooth.done{border-color:var(--ok);background:#dff3e7}
.tooth.sel{background:var(--acc);border-color:var(--acc);color:#fff}
.imgs{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
figure{margin:0;border:1px solid var(--line);border-radius:8px;padding:6px;font-size:12px}
figure img{width:100%;height:120px;object-fit:cover;border-radius:4px;cursor:zoom-in;background:#ddd}
.ov{position:fixed;inset:0;background:#000d;display:flex;align-items:center;justify-content:center;z-index:9}.ov img{max-width:95vw;max-height:95vh}
.login{max-width:320px;margin:12vh auto;display:flex;flex-direction:column;gap:10px}
@media print{.bar,button{display:none}}
